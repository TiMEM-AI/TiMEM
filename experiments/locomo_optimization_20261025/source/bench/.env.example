# TiMEM — register API key & account at https://api.timem.cloud
TIMEM_BASE_URL=https://api.timem.cloud
TIMEM_API_KEY=your_timem_api_key
TIMEM_ACCOUNT_ID=your_account_id

# Mem0 Platform
MEM0_API_KEY=your_mem0_api_key
MEM0_BASE_URL=https://api.mem0.ai
MEM0_INGEST_POLL_TIMEOUT_SEC=120
MEM0_SEARCH_THRESHOLD=0.0

# MemOS Cloud
MEMOS_API_KEY=your_memos_api_key
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1

# Answer and judge (OpenAI-compatible). Both fall back to ARK until overridden.
# Point the judge at Kingsoft Cloud later with JUDGE_API_KEY / JUDGE_API_BASE / JUDGE_MODEL.
ARK_API_KEY=your_ark_api_key
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
JUDGE_MODEL=your_ark_endpoint_id
JUDGE_TEMPERATURE=0
# JUDGE_API_KEY=
# JUDGE_API_BASE=
# ANSWER_API_KEY=
# ANSWER_API_BASE=
# ANSWER_MODEL=

# AML text-track target. The harness calls these URLs as the platform.
AML_ADD_URL=http://127.0.0.1:8001/add
AML_SEARCH_URL=http://127.0.0.1:8001/search
# AML_HEALTH_URL=http://127.0.0.1:8001/health
AML_API_KEY=your_memory_system_key
AML_AUTH=x-api-key

# Benchmark
BENCHMARK_EXPERT_ID=benchmark
# Memory generation language for TiMEM (zh|en). Default en for English LoCoMo gold/recall.
TIMEM_MEMORY_LANGUAGE=en
BENCHMARK_TOP_K=10
BENCHMARK_PERSONA_COUNT=10
BENCHMARK_BACKFILL_TIMEOUT_SEC=600
