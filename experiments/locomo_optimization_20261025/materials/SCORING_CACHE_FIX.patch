+"""Offline final accounting after the two-question cache repair."""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from collections import Counter
+from pathlib import Path
+
+from full_answer import FULL
+
+MATERIALS = FULL.parent / "pr_materials_20261025"
+CATEGORIES = [("2", "时间"), ("4", "单跳"), ("1", "多跳"), ("3", "推理")]
+
+
+def read(p):
+    return json.loads(p.read_text(encoding="utf-8"))
+
+
+def dump(p, data):
+    p.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+
+
+def exact_p(wins, losses):
+    n = wins + losses
+    return min(1.0, 2 * sum(math.comb(n, k) for k in range(min(wins, losses) + 1)) / 2**n)
+
+
+def main():
+    summary = read(FULL / "RESULTS_FULL.json")
+    pairs = {key: Counter() for key in ("L-B", "H-L", "H-B")}
+    changes = Counter()
+    evidence_text_keys = set()
+    for p in sorted((FULL / "answers").glob("*.json")):
+        rec = read(p)
+        qid, stem = rec["question_id"], p.stem
+        evidence = {a: read(FULL / "evidence" / a / f"{stem}.json") for a in ("B", "L", "H")}
+        evidence_text_keys.update(hashlib.sha256(v["evidence"].encode("utf-8")).hexdigest() for v in evidence.values())
+        req = read(FULL / "requests" / f"{stem}_H.json")
+        upper = set(evidence["H"].get("selected") or []) & set(req["upper_ids"])
+        if upper:
+            changes["H_selected_upper_questions"] += 1
+            changes["H_selected_upper_items"] += len(upper)
+        for label, a, b in (("L-B", "L", "B"), ("H-L", "H", "L"), ("H-B", "H", "B")):
+            oka, okb = rec["arms"][a]["correct"], rec["arms"][b]["correct"]
+            outcome = "win" if oka and not okb else "loss" if okb and not oka else "same"
+            pairs[label][outcome] += 1
+            changed = evidence[a]["evidence"] != evidence[b]["evidence"]
+            if not changed:
+                assert rec["arms"][a] == rec["arms"][b], (qid, label)
+            if label in ("L-B", "H-B") and changed:
+                changes[f"{a}_changed_questions"] += 1
+                if outcome != "same":
+                    changes[f"{a}_changed_{outcome}"] += 1
+            if label == "H-B" and upper and outcome != "same":
+                changes[f"H_upper_{outcome}"] += 1
+    before = read(FULL / "cache_repair_20261025" / "ANSWERS_BEFORE_SHA256.json")
+    changed_files = [p.name for p in (FULL / "answers").glob("*.json")
+                     if hashlib.sha256(p.read_bytes()).hexdigest() != before[p.name]]
+    assert set(changed_files) == {"conv-26_q0026.json", "conv-47_q0066.json"}
+    paired = {key: {**value, "net": value["win"]-value["loss"],
+                    "mcnemar_exact_p": exact_p(value["win"], value["loss"])} for key, value in pairs.items()}
+    summary["paired_analysis"] = paired
+    summary["unique_evidence_scored"] = len(evidence_text_keys)
+    summary["unique_evidence_texts"] = len(evidence_text_keys)
+    summary["evidence_analysis"] = dict(changes)
+    summary["repair"]["unchanged_answer_files"] = len(before) - len(changed_files)
+    dump(FULL / "RESULTS_FULL.json", summary)
+    MATERIALS.mkdir(exist_ok=True)
+    dump(MATERIALS / "FINAL_RESULTS.json", summary)
+    dump(FULL / "cache_repair_20261025" / "FINAL_ACCOUNTING.json",
+         {"changed_answer_files": changed_files, "unchanged_answer_files": 859,
+          "paired_analysis": paired, "evidence_analysis": dict(changes)})
+    rows = []
+    csv = ["category,n,B_correct,B_accuracy,L_correct,L_accuracy,H_correct,H_accuracy,H_minus_B_correct"]
+    for code, name in CATEGORIES:
+        values = summary["by_category"][code]
+        rows.append("| " + name + " | " + " | ".join(
+            f"{values[a]['correct']}/{values[a]['n']}（{values[a]['correct']/values[a]['n']:.2%}）" for a in ("B", "L", "H"))
+            + f" | {values['H']['correct']-values['B']['correct']:+d} |")
+        csv.append(",".join([name,str(values['B']['n'])] + [x for a in ("B", "L", "H") for x in
+            (str(values[a]['correct']),f"{values[a]['correct']/values[a]['n']:.8f}")] +
+            [str(values['H']['correct']-values['B']['correct'])]))
+    totals = summary["stats"]
+    rows.append("| **总体** | " + " | ".join(f"**{totals[a]['correct']}/{totals[a]['total']}（{totals[a]['correct']/totals[a]['total']:.2%}）**"
+                for a in ("B", "L", "H")) + " | **+5** |")
+    csv.append(",".join(["总体","861"] + [x for a in ("B", "L", "H") for x in
+        (str(totals[a]['correct']),f"{totals[a]['correct']/totals[a]['total']:.8f}")] + ["5"]))
+    table = "| 类别 | B：低层原始证据 | L：低层候选重排 | H：高层参与重排 | H−B 题数 |\n|---|---:|---:|---:|---:|\n" + "\n".join(rows)
+    (MATERIALS / "RESULTS_FINAL.csv").write_text("\n".join(csv)+"\n", encoding="utf-8-sig")
+    (MATERIALS / "RESULTS_TABLE.md").write_text(table+"\n", encoding="utf-8")
+    report = f"""# 全量 861 题 B/L/H 对照结果（缓存修正定稿）
+
+日期：2026-10-25。协议：V2 候选、完整提示、按标签交换、原模型答题和判分；仅补评两道跨题缓存污染题，859 道答案及全部筛选、证据保持不变。
+
+## 1. 最终成绩
+
+{table}
+
+答题与判分均为 deepseek-v4.1-flash，temperature=0。B/L/H 共享同一事实库；同一问题的完全相同输入共享结果。
+
+## 2. 两题修正
+
+旧 `full_answer.py` 使用跨题的 `cache[evidence_text]`，使两道后续问题复用其他问题的答案和正确标记。现改为绑定问题、完整答题提示、判分模板、金标、模型、端点和温度的请求身份。
